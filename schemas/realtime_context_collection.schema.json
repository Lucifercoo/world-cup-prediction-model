{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Realtime pre-match context collection",
  "type": "object",
  "additionalProperties": false,
  "required": ["collector", "match", "teams", "shape", "key_players"],
  "properties": {
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "reasoning_effort", "collected_at_utc"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "reasoning_effort": {"type": "string", "minLength": 1},
        "collected_at_utc": {"type": "string", "format": "date-time"}
      }
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_bjt", "time_bjt", "team_a", "team_b", "venue"],
      "properties": {
        "date_bjt": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "time_bjt": {"type": "string", "pattern": "^\\d{2}:\\d{2}$"},
        "team_a": {"type": "string", "minLength": 1},
        "team_b": {"type": "string", "minLength": 1},
        "venue": {"type": "string", "minLength": 1}
      }
    },
    "teams": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/team_context"}
    },
    "shape": {"$ref": "#/$defs/shape"},
    "key_players": {
      "type": "array",
      "items": {"$ref": "#/$defs/key_player"}
    }
  },
  "$defs": {
    "nullable_number": {"type": ["number", "null"]},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "url", "published_at"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "published_at": {"type": ["string", "null"]}
      }
    },
    "team_context": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "multipliers", "weather_high_c", "travel_km", "analysis_notes", "sources"],
      "properties": {
        "team": {"type": "string", "minLength": 1},
        "multipliers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["home_adaptation_multiplier", "travel_multiplier", "weather_multiplier", "cohesion_multiplier", "injury_multiplier", "opponent_attack_multiplier", "tempo_multiplier"],
          "properties": {
            "home_adaptation_multiplier": {"type": ["number", "null"], "minimum": 1.0, "maximum": 1.08},
            "travel_multiplier": {"type": ["number", "null"], "minimum": 0.94, "maximum": 1.02},
            "weather_multiplier": {"type": ["number", "null"], "minimum": 0.94, "maximum": 1.03},
            "cohesion_multiplier": {"type": ["number", "null"], "minimum": 0.96, "maximum": 1.03},
            "injury_multiplier": {"type": ["number", "null"], "minimum": 0.90, "maximum": 1.03},
            "opponent_attack_multiplier": {"type": ["number", "null"], "minimum": 0.94, "maximum": 1.08},
            "tempo_multiplier": {"type": ["number", "null"], "minimum": 0.92, "maximum": 1.08}
          }
        },
        "weather_high_c": {"type": ["number", "null"]},
        "travel_km": {"type": ["number", "null"], "minimum": 0},
        "analysis_notes": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pre_match_shapes", "draw_multiplier", "tempo_multiplier", "favorite_attack_multiplier", "underdog_attack_multiplier", "notes", "sources"],
      "properties": {
        "pre_match_shapes": {
          "type": "array",
          "items": {
            "enum": ["collapse_risk", "controlled_favorite", "credible_opponent", "final", "heat_slowdown", "home_pressure", "low_block", "low_conversion", "low_event", "low_event_favorite", "low_stakes", "must_win", "open_favorite", "open_game", "open_mismatch", "rotation", "set_piece_risk", "star_finishing", "star_playmaking", "transition_dog"]
          }
        },
        "draw_multiplier": {"type": "number", "minimum": 0.80, "maximum": 1.25},
        "tempo_multiplier": {"type": "number", "minimum": 0.85, "maximum": 1.15},
        "favorite_attack_multiplier": {"type": "number", "minimum": 0.80, "maximum": 1.15},
        "underdog_attack_multiplier": {"type": "number", "minimum": 0.85, "maximum": 1.20},
        "notes": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
      }
    },
    "key_player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team", "key_player", "status", "impact", "notes", "sources"],
      "properties": {
        "team": {"type": "string", "minLength": 1},
        "key_player": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "impact": {"type": "number", "minimum": -1.0, "maximum": 1.0},
        "notes": {"type": "string", "minLength": 1},
        "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}}
      }
    }
  }
}
